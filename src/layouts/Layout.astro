---
/**
 * Layout.astro — Familia Dental
 * Centro de Alta Especialidad Odontológica
 */

import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Familia Dental — Centro de Alta Especialidad Odontológica",
  description = "Familia Dental: Centro de Alta Especialidad Odontológica. Cuidamos tu sonrisa con tecnología de vanguardia, implantología, ortodoncia, estética dental y más. Agenda tu cita hoy."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="keywords" content="dentista, clínica dental, implantes dentales, ortodoncia, carillas, blanqueamiento, odontopediatría, endodoncia">
  
  <!-- Open Graph -->
  <meta property="og:title" content={title}>
  <meta property="og:description" content="Cuidamos tu sonrisa, cuidamos tu familia. Tecnología de vanguardia y atención premium.">
  <meta property="og:type" content="website">
  <meta property="og:image" content="/assets/images/hero_clinic.jpg">
  
  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/favicon.png">
  <link rel="shortcut icon" href="/favicon.ico">
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  
  <!-- Swiper CSS for Super Flow Hero Slider -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
</head>
<body>

  <!-- CUSTOM CURSOR -->
  <div class="custom-cursor"></div>

  <!-- PRELOADER -->
  <div class="preloader" id="preloader">
    <div class="preloader__content">
      <div class="preloader__logo">
        <img src="/Logo/logo oficial/png/logosimple_png.png" alt="Familia Dental Logo">
      </div>
      <div class="preloader__bar">
        <div class="preloader__fill"></div>
      </div>
    </div>
  </div>

  <slot />

  <!-- FLOATING ELEMENTS -->
  <!-- WhatsApp Button -->
  <a href="https://wa.me/520000000000" target="_blank" rel="noopener" class="whatsapp-btn" aria-label="WhatsApp">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
  </a>

  <!-- Scroll to Top -->
  <button class="scroll-top" aria-label="Scroll to top">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
  </button>

  <!-- SCRIPTS -->
  <!-- GSAP Animation Library -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
  
  <!-- Swiper JS for Super Flow Hero Slider -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
  
  <!-- Translations -->
  <script is:inline src="/translations.js"></script>
  
  <!-- Main Scripts -->
  <script is:inline src="/scripts.js"></script>

</body>
</html>
