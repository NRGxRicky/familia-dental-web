---
/**
 * Footer.astro — Pie de Página Institucional
 */
---

<footer class="footer" id="footer">
  <div class="container">
    <div class="footer__grid">
      <!-- Brand -->
      <div class="footer__brand">
        <img src="/Logo/logo oficial/png/logocompleto_blanco.png" alt="Familia Dental" class="footer__logo-img">
        <p data-i18n="footer_desc">Centro de Alta Especialidad Odontológica. Cuidamos tu sonrisa con la más avanzada tecnología y el mejor equipo humano.</p>
        <div class="footer__social">
          <a href="#" aria-label="Facebook">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
          </a>
          <a href="#" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
          <a href="#" aria-label="TikTok">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 00-.79-.05A6.34 6.34 0 003.15 15.2a6.34 6.34 0 0010.86 4.46V13a8.27 8.27 0 005.58 2.16V11.7a4.83 4.83 0 01-3.77-1.24V6.69h3.77z"/></svg>
          </a>
          <a href="#" aria-label="YouTube">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M22.54 6.42a2.78 2.78 0 00-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 00-1.94 2A29 29 0 001 11.75a29 29 0 00.46 5.33A2.78 2.78 0 003.4 19.1C5.12 19.55 12 19.55 12 19.55s6.88 0 8.6-.46a2.78 2.78 0 001.94-2 29 29 0 00.46-5.25 29 29 0 00-.46-5.42z"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02" fill="white"/></svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="footer__col">
        <h4 data-i18n="footer_links">Enlaces</h4>
        <ul>
          <li><a href="#hero" data-i18n="nav_home">Inicio</a></li>
          <li><a href="#about" data-i18n="nav_about">Nosotros</a></li>
          <li><a href="#services" data-i18n="nav_services">Servicios</a></li>
          <li><a href="#gallery" data-i18n="nav_gallery">Galería</a></li>
          <li><a href="#team" data-i18n="nav_team">Equipo</a></li>
          <li><a href="#blog" data-i18n="nav_blog">Blog</a></li>
        </ul>
      </div>

      <!-- Services -->
      <div class="footer__col">
        <h4 data-i18n="footer_services">Servicios</h4>
        <ul>
          <li><a href="#services" data-i18n="svc1_title">Ortodoncia</a></li>
          <li><a href="#services" data-i18n="svc2_title">Implantología</a></li>
          <li><a href="#services" data-i18n="svc3_title">Estética Dental</a></li>
          <li><a href="#services" data-i18n="svc4_title">Odontopediatría</a></li>
          <li><a href="#services" data-i18n="svc5_title">Endodoncia</a></li>
          <li><a href="#services" data-i18n="svc6_title">Periodoncia</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div class="footer__col">
        <h4 data-i18n="footer_contact">Contacto</h4>
        <ul>
          <li><a href="tel:+520000000000" data-i18n="contact_phone">+52 (000) 000-0000</a></li>
          <li><a href="mailto:info@familiadental.com" data-i18n="contact_email">info@familiadental.com</a></li>
          <li><a href="#map" data-i18n="contact_address">Av. Principal #123</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p data-i18n="footer_rights">© 2026 Familia Dental. Todos los derechos reservados.</p>
      <div>
        <a href="#" data-i18n="footer_privacy">Aviso de Privacidad</a> &nbsp;·&nbsp;
        <a href="#" data-i18n="footer_terms">Términos y Condiciones</a>
      </div>
    </div>
  </div>
</footer>
