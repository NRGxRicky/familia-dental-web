---
/**
 * Services.astro — Las 9 Especialidades de Alta Especialidad Odontológica
 * Optimizado con llamadas a la acción directas por WhatsApp para máxima conversión de pacientes
 */

const servicios = [
  {
    id: "ortodoncia",
    title: "Ortodoncia y Alineadores",
    i18nTitle: "svc1_title",
    desc: "Brackets metálicos, cerámicos y alineadores invisibles para una sonrisa perfectamente alineada y funcional.",
    i18nDesc: "svc1_desc",
    msg: "Hola Familia Dental, me gustaría agendar una consulta de valoración para Ortodoncia y Alineadores Invisibles.",
    svg: `<path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/>`
  },
  {
    id: "implantologia",
    title: "Implantología Avanzada",
    i18nTitle: "svc2_title",
    desc: "Implantes de titanio de primera línea con cirugía guiada digital para reponer piezas con máxima naturalidad y firmeza.",
    i18nDesc: "svc2_desc",
    msg: "Hola Familia Dental, deseo agendar una valoración especializada para Implantes Dentales.",
    svg: `<path d="M12 2a3 3 0 00-3 3v4a3 3 0 006 0V5a3 3 0 00-3-3z"/><path d="M10 9v8l-1 5h6l-1-5V9"/>`
  },
  {
    id: "estetica",
    title: "Diseño de Sonrisa & Estética",
    i18nTitle: "svc3_title",
    desc: "Carillas de porcelana ultra finas, blanqueamiento dental profesional con láser y armonización estética dental.",
    i18nDesc: "svc3_desc",
    msg: "Hola Familia Dental, me interesa una cita de valoración para Diseño de Sonrisa y Estética Dental.",
    svg: `<path d="M12 3c-1.2 0-2.4.6-3 1.7A3.6 3.6 0 004.6 9c-1 .6-1.7 1.8-1.7 3s.7 2.4 1.7 3c-.3 1.5.2 3 1.5 3.8a3.6 3.6 0 004 .2A3.6 3.6 0 0014 21a3.6 3.6 0 003.8-1.5c1.4.3 2.8-.3 3.5-1.6s.4-2.8-.4-3.9c.8-1.1 1.1-2.6.4-3.9s-2.1-1.9-3.5-1.6A3.6 3.6 0 0014 6a3.6 3.6 0 00-2-2.7V3z"/><circle cx="12" cy="12" r="2"/>`
  },
  {
    id: "odontopediatria",
    title: "Odontopediatría Integral",
    i18nTitle: "svc4_title",
    desc: "Atención especializada, lúdica y preventiva para niños en un ambiente libre de temor y con mínima invasión.",
    i18nDesc: "svc4_desc",
    msg: "Hola Familia Dental, quisiera agendar una consulta de Odontopediatría para mis hijos.",
    svg: `<path d="M9 12h.01M15 12h.01M10 16c.5.3 1.2.5 2 .5s1.5-.2 2-.5"/><circle cx="12" cy="12" r="10"/>`
  },
  {
    id: "endodoncia",
    title: "Endodoncia Microscópica",
    i18nTitle: "svc5_title",
    desc: "Tratamiento de conductos con instrumentación rotatoria mecanizada y magnificación para salvar dientes naturales sin dolor.",
    i18nDesc: "svc5_desc",
    msg: "Hola Familia Dental, requiero una valoración urgente o tratamiento de Endodoncia.",
    svg: `<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>`
  },
  {
    id: "periodoncia",
    title: "Periodoncia & Salud Gingival",
    i18nTitle: "svc6_title",
    desc: "Diagnóstico, tratamiento y regeneración de encías y hueso de soporte para asegurar la estabilidad de tu dentadura.",
    i18nDesc: "svc6_desc",
    msg: "Hola Familia Dental, deseo agendar una valoración con el especialista en Periodoncia.",
    svg: `<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0016.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 002 8.5c0 2.3 1.5 4.05 3 5.5l7 7 7-7z"/>`
  },
  {
    id: "cirugia",
    title: "Cirugía Maxilofacial",
    i18nTitle: "svc7_title",
    desc: "Extracción segura de muelas del juicio, biopsias y procedimientos quirúrgicos orales con estrictos protocolos hospitalarios.",
    i18nDesc: "svc7_desc",
    msg: "Hola Familia Dental, necesito agendar una valoración para Cirugía Maxilofacial / Extracciones.",
    svg: `<circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/>`
  },
  {
    id: "protesis",
    title: "Prótesis & Rehabilitación Fija",
    i18nTitle: "svc8_title",
    desc: "Coronas de circonio y disilicato de litio, puentes y prótesis de alta estética que devuelven la capacidad de masticar con confianza.",
    i18nDesc: "svc8_desc",
    msg: "Hola Familia Dental, solicito información y cita para Prótesis Dental / Coronas.",
    svg: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>`
  },
  {
    id: "rehabilitacion",
    title: "Rehabilitación Oral & Limpiezas",
    i18nTitle: "svc9_title",
    desc: "Profilaxis con ultrasonido, eliminación profunda de sarro, resinas estéticas de alta duración y check-up preventivo completo.",
    i18nDesc: "svc9_desc",
    msg: "Hola Familia Dental, me gustaría agendar una Limpieza Dental y revisión general preventiva.",
    svg: `<path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/>`
  }
];
---

<section class="services section" id="services">
  <div class="container">
    <div class="services__header">
      <span class="section-label" data-i18n="services_label">Nuestras Especialidades</span>
      <h2 class="section-title" data-i18n="services_title">Cuidado dental integral para toda la familia</h2>
      <p class="section-subtitle" data-i18n="services_subtitle">Diagnóstico digital de alta precisión, especialistas certificados y materiales biomiméticos de clase mundial.</p>
    </div>

    <div class="services__grid">
      {servicios.map((s) => (
        <div class="service-card" id={`servicio-${s.id}`}>
          <div class="service-card__icon" set:html={`<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">${s.svg}</svg>`} />
          <h3 class="service-card__title" data-i18n={s.i18nTitle}>{s.title}</h3>
          <p class="service-card__desc" data-i18n={s.i18nDesc}>{s.desc}</p>
          <div class="service-card__action" style="margin-top: 1.25rem;">
            <a 
              href={`https://wa.me/520000000000?text=${encodeURIComponent(s.msg)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="service-card__link"
              style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.82rem; font-weight: 700; color: var(--color-primary); text-transform: uppercase; letter-spacing: 0.05em; transition: color 0.2s ease;"
            >
              <span>Agendar Valoración</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
