---
/**
 * Services.astro — Las 9 Especialidades de Alta Gama
 */
---

<section class="services section" id="services">
  <div class="container">
    <div class="services__header">
      <span class="section-label" data-i18n="services_label">Nuestras Especialidades</span>
      <h2 class="section-title" data-i18n="services_title">Cuidado dental integral para toda la familia</h2>
      <p class="section-subtitle" data-i18n="services_subtitle">Ofrecemos tratamientos de alta especialidad con la más avanzada tecnología y los mejores materiales del mercado.</p>
    </div>

    <div class="services__grid">
      <!-- 1. Ortodoncia -->
      <div class="service-card">
        <div class="service-card__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
        </div>
        <h3 class="service-card__title" data-i18n="svc1_title">Ortodoncia</h3>
        <p class="service-card__desc" data-i18n="svc1_desc">Brackets metálicos, cerámicos y alineadores invisibles para una sonrisa perfectamente alineada.</p>
      </div>

      <!-- 2. Implantología -->
      <div class="service-card">
        <div class="service-card__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 00-3 3v4a3 3 0 006 0V5a3 3 0 00-3-3z"/><path d="M10 9v8l-1 5h6l-1-5V9"/></svg>
        </div>
        <h3 class="service-card__title" data-i18n="svc2_title">Implantología</h3>
        <p class="service-card__desc" data-i18n="svc2_desc">Implantes de titanio de primera línea para reemplazar piezas dentales con resultados naturales y duraderos.</p>
      </div>

      <!-- 3. Estética Dental -->
      <div class="service-card">
        <div class="service-card__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c-1.2 0-2.4.6-3 1.7A3.6 3.6 0 004.6 9c-1 .6-1.7 1.8-1.7 3s.7 2.4 1.7 3c-.3 1.5.2 3 1.5 3.8a3.6 3.6 0 004 .2A3.6 3.6 0 0014 21a3.6 3.6 0 003.8-1.5c1.4.3 2.8-.3 3.5-1.6s.4-2.8-.4-3.9c.8-1.1 1.1-2.6.4-3.9s-2.1-1.9-3.5-1.6A3.6 3.6 0 0014 6a3.6 3.6 0 00-2-2.7V3z"/><circle cx="12" cy="12" r="2"/></svg>
        </div>
        <h3 class="service-card__title" data-i18n="svc3_title">Estética Dental</h3>
        <p class="service-card__desc" data-i18n="svc3_desc">Carillas de porcelana, blanqueamiento profesional y diseño de sonrisa digital personalizado.</p>
      </div>

      <!-- 4. Odontopediatría -->
      <div class="service-card">
        <div class="service-card__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12h.01M15 12h.01M10 16c.5.3 1.2.5 2 .5s1.5-.2 2-.5"/><circle cx="12" cy="12" r="10"/></svg>
        </div>
        <h3 class="service-card__title" data-i18n="svc4_title">Odontopediatría</h3>
        <p class="service-card__desc" data-i18n="svc4_desc">Atención especializada para los más pequeños en un ambiente cálido y libre de ansiedad.</p>
      </div>

      <!-- 5. Endodoncia -->
      <div class="service-card">
        <div class="service-card__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
        </div>
        <h3 class="service-card__title" data-i18n="svc5_title">Endodoncia</h3>
        <p class="service-card__desc" data-i18n="svc5_desc">Tratamiento de conductos con tecnología rotativa y microscópica para salvar tus dientes naturales.</p>
      </div>

      <!-- 6. Periodoncia -->
      <div class="service-card">
        <div class="service-card__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0016.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 002 8.5c0 2.3 1.5 4.05 3 5.5l7 7 7-7z"/></svg>
        </div>
        <h3 class="service-card__title" data-i18n="svc6_title">Periodoncia</h3>
        <p class="service-card__desc" data-i18n="svc6_desc">Diagnóstico y tratamiento de enfermedades de las encías para mantener una base sana y fuerte.</p>
      </div>

      <!-- 7. Cirugía Maxilofacial -->
      <div class="service-card">
        <div class="service-card__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
        </div>
        <h3 class="service-card__title" data-i18n="svc7_title">Cirugía Maxilofacial</h3>
        <p class="service-card__desc" data-i18n="svc7_desc">Procedimientos quirúrgicos especializados del área maxilar y facial con precisión hospitalaria.</p>
      </div>

      <!-- 8. Prótesis Dental -->
      <div class="service-card">
        <div class="service-card__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <h3 class="service-card__title" data-i18n="svc8_title">Prótesis Dental</h3>
        <p class="service-card__desc" data-i18n="svc8_desc">Prótesis fijas y removibles de alta calidad que restauran la función y la estética de tu sonrisa.</p>
      </div>

      <!-- 9. Rehabilitación General -->
      <div class="service-card">
        <div class="service-card__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>
        </div>
        <h3 class="service-card__title" data-i18n="svc9_title">Rehabilitación General</h3>
        <p class="service-card__desc" data-i18n="svc9_desc">Restauraciones avanzadas con resinas estéticas y coronas dentales para devolver salud y función a tu boca.</p>
      </div>
    </div>
  </div>
</section>
